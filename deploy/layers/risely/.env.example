# Secret values for this deployment. This file holds names only; copy it to .env and fill in
# the values. .env is gitignored. `qm secrets push` transfers values without persisting
# or printing them.

# Operator secret declared by config secretEnv.core. (core)
ADMIN_GRANTS=

# Anthropic API key: optional fallback. Gemini is registered through the encrypted custom-provider store. (core)
# ANTHROPIC_API_KEY=  # optional

# Comma-separated email addresses allowed to sign in through the built-in broker. (auth, portal)
AUTH_ALLOWED_EMAILS=

# Client secret the portal presents to the built-in auth broker; the CLI generates it for both sides. (auth, portal)
# Generate with: openssl rand -hex 32
AUTH_CLIENT_SECRET=

# Verified sender for sign-in links, e.g. "Acme <no-reply@acme.com>". (auth)
AUTH_EMAIL_FROM=

# P-256 private JSON Web Key the broker signs id_tokens with; the portal verifies it through the broker's JWKS. (auth)
# Generate with: node -e "const {generateKeyPairSync}=require('node:crypto');process.stdout.write(JSON.stringify(generateKeyPairSync('ec',{namedCurve:'P-256'}).privateKey.export({format:'jwk'})))"
AUTH_SIGNING_JWK=

# Key the broker seals sign-in links, authorization codes, and access tokens with; must differ from every other key. (auth)
# Generate with: openssl rand -hex 32
AUTH_TOKEN_SECRET=

# Signing key for scoped agent capabilities and egress grants; must differ from every other key. (core)
# Generate with: openssl rand -hex 32
CAPABILITY_SECRET=

# Dedicated least-privilege PostgreSQL runtime-role URL targeting the existing Risely QM database. (ceo-canary)
CANARY_DATABASE_URL=

# Exact Risely QM RDS endpoint rendered from Terraform for the canary server-side database identity assertion. (ceo-canary)
# CANARY_DATABASE_HOST=  # populated by Terraform task rendering

# Fixed PostgreSQL port paired with CANARY_DATABASE_HOST. (ceo-canary)
# CANARY_DATABASE_PORT=5432

# Exact existing QM database owner and trusted bootstrap administrator, rendered from Terraform. (ceo-canary)
# CANARY_BOOTSTRAP_ADMIN_ROLE=qm

# Operator-only owner-readable libpq password file for the trusted bootstrap administrator. Never inject into an ECS runtime task.
# CANARY_BOOTSTRAP_ADMIN_PASSFILE=

# Operator-only owner-readable PEM file used by psql and post-provision authentication checks.
# CANARY_DATABASE_CA_FILE=

# Dedicated HMAC key held only by the CEO canary and its future reviewed caller. No caller is configured yet. (ceo-canary)
# Generate with: openssl rand -hex 32
CANARY_INGRESS_SECRET=

# Dedicated HMAC key for the dormant QM shadow observation route. It must differ from CANARY_INGRESS_SECRET and is not bound to the current task. (ceo-canary)
# Generate with: openssl rand -hex 32
# CANARY_QM_SHADOW_INGRESS_SECRET=

# Dedicated migrator-role PostgreSQL URL targeting the existing Risely QM database, used only by operator-run canary migration and retention. Never inject into ECS runtime tasks.
CANARY_MIGRATION_DATABASE_URL=

# Operator-only owner-readable generated credential files. Values must be distinct base64url strings and must never be placed in this environment file.
# CANARY_MIGRATION_PASSWORD_FILE=
# CANARY_RUNTIME_PASSWORD_FILE=

# Encryption key for durable connector credentials; must differ from every other key. (core)
# Generate with: openssl rand -hex 32
CONNECTOR_SECRET_KEY=

# HMAC key shared by core and surface plugins. (admin, auth, core, portal, slack, web-ui)
# Generate with: openssl rand -hex 32
CORE_SIGNING_SECRET=

# Amazon RDS us-west-2 root CA bundle (PEM content). Required by this AWS
# deployment so PostgreSQL verifies the certificate chain and endpoint. (core, ceo-canary)
# Download: https://truststore.pki.rds.amazonaws.com/us-west-2/us-west-2-bundle.pem
DATABASE_CA_CERT=

# Postgres connection string for durable state. (core)
# DATABASE_URL=  # populated by Terraform

# OpenRouter API key: bills the base model when modelProvider is "openrouter", an optional deployment fallback otherwise. (core)
# OPENROUTER_API_KEY=  # optional

# Signing key for portal-bound user identity; must differ from every other key. (admin, core, portal, web-ui)
# Generate with: openssl rand -hex 32
PORTAL_IDENTITY_SECRET=

# Cookie-signing secret for portal sessions. (portal)
# Generate with: openssl rand -hex 32
PORTAL_SESSION_SECRET=

# Public core self-API URL reachable from agent sandboxes. (core)
PUBLIC_API_URL=

# SMTP relay host used to deliver sign-in links. (auth)
SMTP_HOST=

# SMTP username used to deliver sign-in links. (auth)
SMTP_USERNAME=

# SMTP password used to deliver sign-in links. (auth)
SMTP_PASSWORD=

# Stable signing key for reviewed skills. (core)
# Generate with: openssl rand -hex 32
SKILL_SIGNING_SECRET=

# Optional at first deploy; Slack Socket Mode app token. (slack)
# SLACK_APP_TOKEN=  # optional

# Optional at first deploy; Slack bot OAuth token. (slack)
# SLACK_BOT_TOKEN=  # optional

# OpenAI API key: the Codex harness needs it (its CLI cannot do browser OAuth in a container), and it bills the base model when modelProvider is "openai". (core)
# Needed when env.core.HARNESS is "codex" or modelProvider is "openai".
# OPENAI_API_KEY=

# Fly deploy token scoped to the agent-computer app. (core)
# Needed when the target is fly.
# Generate with: fly tokens create deploy -a <sandbox-app> -x 8760h
# FLY_SANDBOX_API_TOKEN=

# Fly organization token used only by qm's opt-in per-deployment app publisher. (core)
# Needed when env.core.DEPLOY_PROVIDER is "fly".
# Generate with: fly tokens create org -o <fly-org> -x 8760h
# FLY_DEPLOY_API_TOKEN=

# Fly Sprites API token for the agent-computer substrate. (core)
# Needed when env.core.SANDBOX_BACKEND is "sprites".
# Generate with: sprite login   # then copy the token from ~/.sprite/credentials
# SPRITES_TOKEN=

# smolmachines API key for the agent-computer substrate. (core)
# Needed when env.core.SANDBOX_BACKEND is "smolmachines".
# Generate with: create an API key in the smolmachines console (https://smolmachines.com/console)
# SMOLMACHINES_TOKEN=

# HMAC key protecting public AWS deployment-app URLs. (core)
# Needed when env.core.AWS_DEPLOY_APPS_DOMAIN is set.
# Generate with: openssl rand -hex 32
# AWS_DEPLOY_GATE_SECRET=

# Google OAuth client secret. (core)
# Needed when env.core.GOOGLE_OAUTH_CLIENT_ID is set.
# GOOGLE_OAUTH_CLIENT_SECRET=

# Dropbox OAuth client secret. (core)
# Needed when env.core.DROPBOX_OAUTH_CLIENT_ID is set.
# DROPBOX_OAUTH_CLIENT_SECRET=

# Linear OAuth client secret. (core)
# Needed when env.core.LINEAR_OAUTH_CLIENT_ID is set.
# LINEAR_OAUTH_CLIENT_SECRET=

# Slack request-signing secret (from the Slack app's Basic Information page); HTTP events mode only. (slack)
# Needed when env.slack.SLACK_EVENTS_MODE is "http".
# SLACK_SIGNING_SECRET=

# Deployment-specific OIDC client identifier when it should not be committed. (portal)
# Needed when the auth service is not enabled and env.portal.OIDC_CLIENT_ID is not set.
# OIDC_CLIENT_ID=

# Client secret issued by an external identity provider; the built-in auth broker mints its own instead. (portal)
# Needed when the auth service is not enabled.
# OIDC_CLIENT_SECRET=

# Deployment-specific OIDC workspace trust boundary when it should not be committed. (portal)
# Needed when the auth service is not enabled and none of env.portal.{OIDC_ALLOWED_EMAILS, OIDC_ALLOWED_EMAIL_DOMAIN, PORTAL_EXPECTED_TEAM_ID} are set.
# PORTAL_EXPECTED_TEAM_ID=
