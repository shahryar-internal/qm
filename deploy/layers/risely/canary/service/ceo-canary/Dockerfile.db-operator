FROM alpine:3.23.3@sha256:59855d3dceb3ae53991193bd03301e082b2a7faa56a514b03527ae0ec2ce3a95 AS runtime-rootfs
RUN apk add --no-cache --upgrade musl=1.2.5-r23 musl-utils=1.2.5-r23 zlib=1.3.2-r0 ca-certificates=20260611-r0 libgcc=15.2.0-r2 libstdc++=15.2.0-r2 libcrypto3=3.5.8-r0 libssl3=3.5.8-r0 postgresql-common=1.2-r2 lz4-libs=1.10.0-r0 libpq=18.6-r0 ncurses-terminfo-base=6.5_p20251123-r0 libncursesw=6.5_p20251123-r0 readline=8.3.1-r0 zstd-libs=1.5.7-r2 postgresql16-client=16.15-r0 && addgroup -g 1000 -S node && adduser -u 1000 -S -G node -s /sbin/nologin node

FROM 075343201918.dkr.ecr.us-west-2.amazonaws.com/risely-qm-pilot-ceo-canary@sha256:264263fc1698d169c55f14c86d39164db84b1517c8e10ba4ffaf28605dcafc69 AS proven-node
RUN printf '%s  %s\n' e8d2cd6aba8f30e3fc7e686d32d7d851f33a7e5dbbc9b16fd0c3b2e65601c506 /usr/local/bin/node | sha256sum -c - && test "$(node --version)" = v24.20.0 && test "$(node -p process.versions.openssl)" = 3.5.8 && test "$(node -p process.config.variables.node_shared_openssl)" = true

FROM node:24.20.0-alpine@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf AS production-dependencies
WORKDIR /app/canary/service/ceo-canary
COPY service/ceo-canary/db-operator/package.json service/ceo-canary/db-operator/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

FROM scratch
ARG SOURCE_REVISION
ARG SOURCE_CLOSURE_SHA256
COPY --from=runtime-rootfs / /
COPY --from=proven-node /usr/local/bin/node /usr/local/bin/node
WORKDIR /app/canary/service/ceo-canary
ENV NODE_ENV=production \
    AWS_REGION=us-west-2 \
    CANARY_DATABASE_SCHEMA=risely_agent_runtime \
    CANARY_DATABASE_NAME=qm \
    CANARY_DATABASE_PORT=5432 \
    CANARY_BOOTSTRAP_ADMIN_ROLE=qm \
    CANARY_OWNER_DATABASE_USER=risely_agent_runtime_owner \
    CANARY_RUNTIME_DATABASE_USER=risely_agent_runtime_runtime \
    CANARY_MIGRATION_DATABASE_USER=risely_agent_runtime_migrator \
    CANARY_MUTATIONS_ENABLED=0 \
    CANARY_PROVIDER_EXECUTION_ENABLED=0
LABEL org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.base.name="scratch+alpine:3.23.3@sha256:59855d3dceb3ae53991193bd03301e082b2a7faa56a514b03527ae0ec2ce3a95" \
      ai.risely.node.version="24.20.0" \
      ai.risely.node.sha256="e8d2cd6aba8f30e3fc7e686d32d7d851f33a7e5dbbc9b16fd0c3b2e65601c506" \
      ai.risely.openssl.version="3.5.8" \
      ai.risely.db-operator.source-closure-sha256="${SOURCE_CLOSURE_SHA256}" \
      ai.risely.db-operator.base-revision="08a9948f525cfb61e148c05f9072d2e526478b04"
COPY --from=production-dependencies --chown=1000:1000 /app/canary/service/ceo-canary/node_modules ./node_modules
COPY --chown=1000:1000 service/ceo-canary/src/catalog-authority-v8.mjs \
     service/ceo-canary/src/database-connection.mjs \
     service/ceo-canary/src/database-security.mjs \
     service/ceo-canary/src/db-operator-bootstrap-sql.mjs \
     service/ceo-canary/src/db-operator.mjs \
     service/ceo-canary/src/migrate.mjs \
     service/ceo-canary/src/provision-credentials.mjs \
     service/ceo-canary/src/schema.mjs \
     ./src/
USER node
ENTRYPOINT ["node", "/app/canary/service/ceo-canary/src/db-operator.mjs"]
